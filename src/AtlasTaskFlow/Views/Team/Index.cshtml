@model IReadOnlyList<TeamMemberView>
@inject CurrentUserContext Current
@{
    ViewData["Title"] = "Team";
    var isLeader = Current.Membership.Role == TeamRole.Leader;
}
<div class="page-head">
    <div>
        <h1>@Current.Team.TeamName</h1>
        <p class="text-body-secondary mb-0">@Model.Count members. Leaders can give a member manager permissions to create and approve tasks.</p>
    </div>
</div>
<section class="panel">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Name</th><th>Role</th><th>Open tasks</th>@if (isLeader) {<th class="text-end">Permissions</th>}</tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar avatar-sm">@m.User.Initials</span>
                                <div>
                                    <div class="fw-semibold">@m.User.FullName</div>
                                    <div class="small text-body-secondary">@m.User.Email</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            @(m.Membership.Role == TeamRole.Leader ? "Team Leader" : "Team Member")
                            @if (m.Membership.HasManagerPermissions) { <span class="badge text-bg-info ms-1">Manager</span> }
                        </td>
                        <td>@m.OpenTasks</td>
                        @if (isLeader)
                        {
                            <td class="text-end">
                                @if (m.Membership.Role != TeamRole.Leader)
                                {
                                    <form method="post" asp-action="ToggleManager" class="d-inline">
                                        <input type="hidden" name="userId" value="@m.User.UserId" />
                                        <button class="btn btn-sm btn-outline-secondary">
                                            @(m.Membership.HasManagerPermissions ? "Remove manager" : "Make manager")
                                        </button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
<p class="small text-body-secondary mt-3">Email invitations arrive with sign-up in Sprint 6.</p>
