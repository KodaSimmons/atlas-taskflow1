@model IReadOnlyList<User>
@if (Model.Count == 0)
{
    <span class="text-body-secondary small">Unassigned</span>
}
else
{
    <span class="avatar-stack">
        @foreach (var u in Model)
        {
            <span class="avatar avatar-sm" title="@u.FullName">@u.Initials</span>
        }
    </span>
}
